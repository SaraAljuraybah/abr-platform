# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve` (gitignored);
# on a hosted project use `supabase secrets set`. Never commit real values.

# HMAC key for rate-limit keys (client IPs are hashed with it, never stored raw). 32+ characters,
# random, different per environment. Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEREST_IP_HASH_SECRET=

# Exact browser origins allowed to call public form endpoints, comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
