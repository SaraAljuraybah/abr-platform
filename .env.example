# Browser-safe configuration only. Every VITE_* value is bundled into public JavaScript.
# NEVER put a secret key (sb_secret_...) or a service-role key here or in any VITE_* variable.
#
# Local development: copy to .env.local, run `npm run db:start`, then paste the
# "Project URL" and "Publishable" key printed by `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
